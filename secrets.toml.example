# ============================================================================
# STREAMLIT SECRETS - SEMANA SST CLINICA SAN RAFAEL
# ============================================================================
# Copia este archivo como .streamlit/secrets.toml (sin ".example") y completa
# con tus credenciales REALES. NUNCA subas secrets.toml a git.
# En Streamlit Cloud configura los mismos valores en Settings -> Secrets.

# ---------------------------------------------------------------------------
# Supabase (obtenlas de: https://app.supabase.com -> Project Settings -> API)
# ---------------------------------------------------------------------------
[supabase]
url = "https://TU-PROYECTO.supabase.co"
service_key = "eyJhbGciOiJIUzI1NiIsInR5cCI6..."  # service_role key (NO la anon)
                                     # La service_role key permite RLS bypass

# ---------------------------------------------------------------------------
# Gmail SMTP (para envio de codigos 2FA)
# Pasos:
#   1. Activa verificacion en 2 pasos en tu cuenta Gmail
#   2. Genera una "App password" en https://myaccount.google.com/apppasswords
#   3. Pega aqui la contrasena de 16 caracteres (sin espacios)
# ---------------------------------------------------------------------------
[smtp]
host = "smtp.gmail.com"
port = 465
user = "tu_correo@gmail.com"
password = "abcd-efgh-ijkl-mnop"        # 16 caracteres
from_name = "Semana SST - Clinica San Rafael"
from_email = "tu_correo@gmail.com"

# ---------------------------------------------------------------------------
# Configuracion adicional de la app
# ---------------------------------------------------------------------------
[app]
evento_nombre = "Semana SST 2025"
clinica_nombre = "Clinica San Rafael Alta Complejidad SAS"
